# Taskey Server Environment Variables
# Copy this file to .env and update values before production deployment

# PostgreSQL
POSTGRES_DB=taskey
POSTGRES_USER=taskey
POSTGRES_PASSWORD=change_me_in_production

# Application
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database connection (must match PostgreSQL values)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskey
DB_USER=taskey
DB_PASS=change_me_in_production

# ── Nginx / TLS ──────────────────────────────────────────────
# TLS'i etkinleştirmek için:
#   1. NGINX_CONF=nginx-ssl.conf olarak değiştirin
#   2. ./certs/ klasörüne server.crt ve server.key dosyalarını koyun
# Varsayılan: nginx.conf (HTTP-only, TLS kapalı)
NGINX_CONF=nginx.conf
