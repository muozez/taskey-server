                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "workspace": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "status": { "type": "string" },
                        "currentVersion": { "type": "integer" },
                        "syncStrategy": { "type": "string" }
                      }
                    },
                    "client": { "$ref": "#/components/schemas/ConnectedClient" }
                  }
                }
              }
