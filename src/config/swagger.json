    "/api/join": {
      "post": {
        "tags": ["Join"],
        "summary": "Lokal client join key ile workspace'e katılır",
        "description": "Auth gerektirmez. Lokal uygulama bu endpoint ile remote server'a bağlanır. Katılım sonrası client `POST /api/sync/full` ile tam snapshot almalı veya `GET /api/sync/pull?sinceVersion=0` ile başlangıç verilerini çekmelidir.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/JoinRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Başarıyla katıldı — clientId ve currentVersion döner",
            "content": {
              "application/json": {
